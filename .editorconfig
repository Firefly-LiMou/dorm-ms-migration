# 根级配置：统一编码、换行与缩进（全仓强制）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# 后端 Java：4 空格缩进
[*.java]
indent_style = space
indent_size = 4

# 前端与配置文件：2 空格缩进
[*.{js,ts,vue,jsx,tsx,json,yml,yaml,css,scss,html}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
